{
  "manifest_version": 3,
  "name": "Video Detector & Downloader",
  "version": "1.0.0",
  "description": "Detect and download all videos on any webpage",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "webRequest",
    "webNavigation",
    "storage",
    "nativeMessaging",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["video-downloader.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "settings.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
